# Copy this file to .env and fill in values — never commit .env

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://ml_tracker:changeme@localhost:5432/ml_tracker
POSTGRES_USER=ml_tracker
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ml_tracker

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT Auth ──────────────────────────────────────────────────────────────────
SECRET_KEY=replace-with-256-bit-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── MinIO / Object Storage ────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=ml-artifacts

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
API_V1_PREFIX=/api/v1
PROJECT_NAME=ML Experiment Tracker
